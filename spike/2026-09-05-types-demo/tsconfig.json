{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@table/core": ["./src/core-types.ts"] }
  },
  "include": ["src/**/*", "src/**/*.vue", "tests/**/*", "vite.config.ts"]
}
